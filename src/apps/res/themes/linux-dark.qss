QWidget { color: #e8ebf1; selection-background-color: #326fbd; selection-color: #ffffff; font-size: 9pt; }
QMainWindow, QDialog, QWidget#topLevelWidget, QTabWidget::pane { background: #181b21; }
QMenuBar, QMenu { background: #20242c; color: #e8ebf1; border: 1px solid #303743; }
QMenu::item { padding: 6px 24px 6px 10px; border-radius: 4px; }
QMenu::item:selected { background: #2c3c52; }
QGroupBox { background: #1e222a; border: 1px solid #343b47; border-radius: 7px; margin-top: 13px; padding: 12px 9px 9px 9px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #aebbd0; }
QPushButton, QToolButton { background: #2a303a; border: 1px solid #414a58; border-radius: 6px; padding: 5px 11px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #343e4c; border-color: #5b83b8; }
QPushButton:pressed, QToolButton:pressed { background: #222a35; }
QPushButton:disabled, QToolButton:disabled { color: #717b89; background: #22262d; border-color: #303640; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #13161b; color: #e8ebf1; border: 1px solid #3a424f; border-radius: 5px; padding: 5px 7px; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #6a9fe3; }
QTabBar::tab { background: #20242c; color: #abb5c4; border: 1px solid #343b47; padding: 7px 12px; margin-right: 3px; }
QTabBar::tab:selected { background: #2a3442; color: #ffffff; border-bottom: 2px solid #6c9fe1; }
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget { background: #16191f; alternate-background-color: #1c2027; border: 1px solid #343b47; border-radius: 5px; gridline-color: #303743; outline: 0; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #29486d; }
QHeaderView::section { background: #242a33; color: #cbd3df; border: 0; border-right: 1px solid #343b47; border-bottom: 1px solid #343b47; padding: 6px; }
QCheckBox, QRadioButton { spacing: 7px; }
QToolTip { background: #252b35; color: #eef2f7; border: 1px solid #475365; padding: 5px; }
