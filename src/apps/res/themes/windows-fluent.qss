QWidget { color: #20242b; selection-background-color: #cce4ff; selection-color: #10253d; font-size: 9pt; }
QMainWindow, QDialog, QWidget#topLevelWidget, QTabWidget::pane { background: #f5f6f8; }
QMenuBar, QMenu { background: #ffffff; color: #20242b; border: 1px solid #e1e4e9; }
QMenu::item { padding: 6px 24px 6px 10px; border-radius: 4px; }
QMenu::item:selected { background: #e7f1fc; }
QGroupBox { background: #ffffff; border: 1px solid #e1e4e9; border-radius: 7px; margin-top: 13px; padding: 12px 9px 9px 9px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #4b5665; }
QPushButton, QToolButton { background: #ffffff; border: 1px solid #d5dbe3; border-radius: 5px; padding: 5px 11px; min-height: 20px; }
QPushButton:hover, QToolButton:hover { background: #f1f6fc; border-color: #9bbce3; }
QPushButton:pressed, QToolButton:pressed { background: #e5edf7; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QComboBox { background: #ffffff; color: #20242b; border: 1px solid #cfd6df; border-radius: 5px; padding: 5px 7px; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid #3978bd; }
QTabBar::tab { background: #eceff3; color: #596474; border: 1px solid #dce1e8; padding: 7px 12px; margin-right: 3px; }
QTabBar::tab:selected { background: #ffffff; color: #1c2735; border-bottom: 2px solid #2878c8; }
QListView, QTreeView, QTableView, QListWidget, QTreeWidget, QTableWidget { background: #ffffff; alternate-background-color: #f6f8fa; border: 1px solid #dce1e8; border-radius: 5px; gridline-color: #e7eaf0; outline: 0; }
QListView::item:selected, QTreeView::item:selected, QTableView::item:selected { background: #dcecff; }
QHeaderView::section { background: #f1f3f6; color: #3d4857; border: 0; border-right: 1px solid #e1e5eb; border-bottom: 1px solid #e1e5eb; padding: 6px; }
QCheckBox, QRadioButton { spacing: 7px; }
QToolTip { background: #fffefb; color: #20242b; border: 1px solid #cbd3dd; padding: 5px; }
